{
  "name": "sr2-platform",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "admin:provision": "tsx scripts/provision-admin.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply sr2-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply sr2-production --remote",
    "cf:types": "wrangler types --env-interface CloudflareEnv"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "bcryptjs": "^2.4.3",
    "jose": "^5.10.0",
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@opennextjs/cloudflare": "^1.20.18"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "@next/env": "^15.2.4",
    "wrangler": "^4.166.0"
  }
}
