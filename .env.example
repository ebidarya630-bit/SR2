# Local development only. Never commit .env.local.
DATABASE_PATH=./data/sr2.sqlite
UPLOADS_DIR=./data/uploads
# Generate a unique random secret of at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=adminsr@gmail.com
# New private password (14+ characters). Used only by npm run admin:provision.
ADMIN_PASSWORD=replace-with-a-new-private-password-of-at-least-14-characters
# Email delivery for one-time verification codes (Resend)
RESEND_API_KEY=re_your_private_api_key
RESEND_FROM=SR2 <no-reply@your-verified-domain.example>
